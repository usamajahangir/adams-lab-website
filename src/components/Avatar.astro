---
import { initials } from '@/lib/content';
interface Props { name: string; photo?: string; class?: string; size?: 'sm' | 'md' | 'lg' | 'fill' }
const { name, photo, class: cls = '', size = 'md' } = Astro.props;
const sizes = { sm: 'size-9 text-xs', md: 'size-14 text-base', lg: 'size-40 text-4xl', fill: 'size-full text-4xl' };
---

{photo ? (
  <img src={photo} alt={name} loading="lazy" decoding="async" class:list={['object-cover', sizes[size], cls]} />
) : (
  <span
    role="img"
    aria-label={name}
    class:list={['flex items-center justify-center bg-gradient-to-br from-forest-600 to-forest-900 font-serif font-semibold text-forest-100', sizes[size], cls]}
  >
    {initials(name)}
  </span>
)}
