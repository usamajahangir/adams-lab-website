---
import { NAV, SITE } from '@/site';
const year = new Date().getFullYear();
---

<footer class="grain relative mt-28 overflow-hidden bg-forest-950 text-forest-100">
  <div class="bg-grid mask-fade-b absolute inset-0"></div>
  <div class="pointer-events-none absolute -top-40 left-1/3 size-[30rem] rounded-full bg-forest-600/30 blur-[120px]"></div>

  <div class="container-x relative grid gap-12 pt-20 pb-12 md:grid-cols-12">
    <div class="md:col-span-5">
      <span class="logo-mask w-64 text-white" aria-hidden="true"></span>
      <span class="sr-only">{SITE.fullName}</span>
      <p class="mt-6 max-w-sm text-sm leading-relaxed text-forest-100/65">{SITE.footerName}</p>
      <p class="mt-2 max-w-sm text-sm leading-relaxed text-forest-100/65">{SITE.contactLead}</p>
      <a href={`mailto:${SITE.email}`} class="glass mt-6 inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm text-white transition hover:bg-white/20">
        <span class="size-1.5 rounded-full bg-amber-400"></span>{SITE.email}
      </a>
    </div>

    <div class="md:col-span-3">
      <h2 class="font-sans text-xs font-semibold tracking-[0.18em] text-amber-400 uppercase">Explore</h2>
      <ul class="mt-5 grid grid-cols-2 gap-2.5 text-sm md:grid-cols-1">
        {NAV.map((n) => <li><a href={n.href} class="text-forest-100/70 transition hover:text-white">{n.label}</a></li>)}
      </ul>
    </div>

    <div class="md:col-span-4">
      <h2 class="font-sans text-xs font-semibold tracking-[0.18em] text-amber-400 uppercase">Contact Us</h2>
      <address class="mt-5 space-y-1 text-sm text-forest-100/70 not-italic">
        <p class="font-medium text-white">{SITE.university}</p>
        <p>{SITE.building}</p>
        <p>{SITE.address}</p>
      </address>
    </div>
  </div>

  <!-- Oversized wordmark -->
  <div class="relative select-none" aria-hidden="true">
    <p class="container-x translate-y-[18%] text-center font-serif text-[22vw] leading-none font-bold tracking-tighter text-transparent [-webkit-text-stroke:1px_rgba(211,232,222,0.18)] lg:text-[16rem]">
      ADaMS
    </p>
  </div>

  <div class="relative border-t border-white/10 bg-forest-950/80 backdrop-blur">
    <div class="container-x flex flex-col gap-2 py-6 text-xs text-forest-100/50 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} ADaMS LAB</p>
      <p>Edmonton, Alberta, Canada</p>
    </div>
  </div>
</footer>
