---
import Avatar from './Avatar.astro';
import type { Member } from '@/lib/content';
interface Props { member: Member; compact?: boolean }
const { member, compact = false } = Astro.props;
const { name, role, photo } = member.data;
---

{compact ? (
  <a href={`/team/${member.id}`} class="group flex items-center gap-3 rounded-xl border border-line bg-white p-3 transition hover:border-forest-300 hover:bg-forest-50">
    <Avatar name={name} photo={photo} size="sm" class="rounded-full" />
    <span class="min-w-0">
      <span class="block truncate text-sm font-semibold text-forest-900 group-hover:text-forest-700">{name}</span>
      <span class="block truncate text-xs text-muted">{role}</span>
    </span>
  </a>
) : (
  <a href={`/team/${member.id}`} class="spotlight group card card-hover block p-2" data-reveal>
    <div class="relative aspect-[4/5] overflow-hidden rounded-[1.25rem] bg-forest-100">
      <Avatar name={name} photo={photo} size="fill" class="saturate-[0.85] transition duration-700 group-hover:scale-105 group-hover:saturate-100" />
      <div class="absolute inset-0 bg-gradient-to-t from-forest-950/70 via-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>
      <span class="glass absolute right-3 bottom-3 left-3 translate-y-2 rounded-full px-3 py-1.5 text-center text-xs font-semibold text-white opacity-0 transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">View profile →</span>
    </div>
    <div class="px-3 pt-4 pb-3">
      <h3 class="font-sans text-base font-semibold text-forest-900">{name}</h3>
      <p class="mt-0.5 text-sm text-muted">{role}</p>
    </div>
  </a>
)}
