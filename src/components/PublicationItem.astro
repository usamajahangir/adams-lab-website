---
import { doiUrl, type Publication, type Member } from '@/lib/content';
interface Props { pub: Publication; memberMap: Map<string, Member>; highlight?: string }
const { pub, memberMap, highlight } = Astro.props;
const { title, authors, venue, year, type, doi, url, pdf, members } = pub.data;

// Link authors that are lab members to their profile
const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/^dr\.?\s+/, '').replace(/[.\-]/g, ' ').replace(/\s+/g, ' ').trim();
const lookup = new Map<string, string>();
for (const ref of members) {
  const m = memberMap.get(ref.id);
  if (!m) continue;
  [m.data.name, ...m.data.aliases].forEach((n) => lookup.set(norm(n), m.id));
}
const link = doiUrl(doi) ?? url;
const typeLabel = { journal: 'Journal', conference: 'Conference', preprint: 'Preprint', 'book-chapter': 'Book chapter', thesis: 'Thesis' }[type];
const search = [title, venue, ...authors].join(' ').toLowerCase();
---

<li class="spotlight group relative overflow-hidden rounded-3xl border border-line bg-white p-6 transition duration-300 hover:border-forest-200 hover:shadow-[0_20px_40px_-24px_rgba(4,51,27,0.35)] before:absolute before:inset-y-6 before:left-0 before:w-[3px] before:origin-top before:scale-y-0 before:rounded-full before:bg-amber-500 before:transition-transform before:duration-300 hover:before:scale-y-100"
  data-pub data-year={year} data-type={type} data-members={members.map((m) => m.id).join(' ')} data-search={search}>
  <div class="flex flex-wrap items-center gap-2 text-xs">
    <span class="font-semibold text-forest-700">{year}</span>
    <span class="text-line">•</span>
    <span class="chip">{typeLabel}</span>
  </div>
  <h3 class="mt-2 font-sans text-[1.02rem] leading-snug font-semibold text-forest-950">
    {link ? <a href={link} target="_blank" rel="noopener" class="hover:text-forest-700 after:absolute after:inset-0">{title}</a> : title}
  </h3>
  <p class="mt-1.5 text-sm leading-relaxed text-muted">
    {authors.map((a, i) => {
      const id = lookup.get(norm(a));
      const node = id
        ? <a href={`/team/${id}`} class:list={['relative z-10 font-medium underline decoration-forest-300 underline-offset-2 hover:text-forest-700', id === highlight ? 'text-forest-800' : 'text-ink/80']}>{a}</a>
        : <span>{a}</span>;
      return <>{node}{i < authors.length - 1 ? ', ' : ''}</>;
    })}
  </p>
  <p class="mt-1 text-sm text-ink/70 italic">{venue}</p>
  {(doi || pdf) && (
    <div class="relative z-10 mt-3 flex flex-wrap gap-2">
      {doi && <a href={doiUrl(doi)} target="_blank" rel="noopener" class="rounded-full border border-line px-3 py-1 text-xs font-medium text-forest-700 hover:border-forest-400">DOI ↗</a>}
      {pdf && <a href={pdf} target="_blank" rel="noopener" class="rounded-full border border-line px-3 py-1 text-xs font-medium text-forest-700 hover:border-forest-400">PDF</a>}
    </div>
  )}
</li>
