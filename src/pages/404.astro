---
import Base from '@/layouts/Base.astro';
---

<Base title="Page not found" overlayHeader={false}>
  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-serif text-8xl font-semibold text-forest-200">404</p>
    <h1 class="mt-4 text-3xl sm:text-4xl">This page couldn’t be found</h1>
    <p class="mt-3 max-w-md text-muted">The page may have moved when we rebuilt the site.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Go home</a>
      <a href="/research" class="btn-outline">Research</a>
    </div>
  </section>
</Base>
