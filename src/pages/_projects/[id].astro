---
import { getCollection, getEntry, getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import MemberCard from '@/components/MemberCard.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { getMemberMap, getPublications, sortMembers } from '@/lib/content';

export async function getStaticPaths() {
  return (await getCollection('projects')).map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const area = await getEntry(entry.data.area);
const members = (await getEntries(entry.data.members)).sort(sortMembers);
const memberMap = await getMemberMap();
// Publications explicitly linked to this project
const pubs = (await getPublications()).filter((p) => p.data.projects.some((r) => r.id === entry.id));
---

<Base title={entry.data.title} description={entry.data.summary} image={entry.data.image}>
  <PageHero eyebrow={area?.data.short ?? 'Project'} title={entry.data.title} lead={entry.data.summary} image={entry.data.image}>
    <div class="mt-6 flex flex-wrap gap-2">
      <span class:list={['rounded-full px-3 py-1 text-xs font-semibold uppercase', entry.data.status === 'active' ? 'bg-amber-500 text-forest-950' : 'bg-white/15 text-white']}>{entry.data.status}</span>
      {entry.data.tags.map((t) => <span class="rounded-full bg-white/10 px-3 py-1 text-xs text-forest-100 ring-1 ring-white/15">{t}</span>)}
    </div>
  </PageHero>

  <section class="container-x grid gap-12 py-16 lg:grid-cols-12">
    <div class="lg:col-span-7">
      {entry.data.image && <img src={entry.data.image} alt="" class="mb-10 aspect-[16/9] w-full rounded-3xl object-cover" />}
      <div class="prose-lab">{entry.data.description.map((p) => <p>{p}</p>)}</div>
      {area && (
        <a href={`/research/${area.id}`} class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-forest-700 hover:text-forest-900">
          ← Part of {area.data.title}
        </a>
      )}
    </div>
    <aside class="lg:col-span-5">
      <div class="sticky top-28 rounded-3xl border border-line bg-white p-6">
        <h2 class="font-sans text-xs font-semibold tracking-[0.18em] text-forest-600 uppercase">Team ({members.length})</h2>
        <div class="mt-4 grid gap-2">{members.map((m) => <MemberCard member={m} compact />)}</div>
      </div>
    </aside>
  </section>

  {pubs.length > 0 && (
    <section class="container-x pb-8">
      <h2 class="text-2xl sm:text-3xl">Related publications</h2>
      <ul class="mt-6 space-y-4">{pubs.map((p) => <PublicationItem pub={p} memberMap={memberMap} />)}</ul>
    </section>
  )}
</Base>
