---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Lightbox from '@/components/Lightbox.astro';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const general = ['/images/gallery/g01.jpg', '/images/gallery/g02.jpg', '/images/site/hero.jpg', '/images/site/focus.jpg'];
const images = [
  ...general.map((src) => ({ src, label: 'Lab' })),
  ...research.flatMap((r) => [r.data.image, ...r.data.gallery].map((src) => ({ src, label: r.data.short }))),
];
---

<Base title="Gallery" description="Photos from the ADaMS Lab facilities.">
  <PageHero eyebrow="Gallery" title="Gallery" lead="[Placeholder] Short intro text for the gallery goes here." image="/images/gallery/g01.jpg" />
  <section class="container-x py-14 sm:py-20">
    <div class="columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4">
      {images.map((img) => (
        <button type="button" data-lightbox={img.src} class="group relative block w-full overflow-hidden rounded-2xl" aria-label={`Open ${img.label} image`} data-reveal>
          <img src={img.src} alt="" loading="lazy" class="w-full transition duration-700 group-hover:scale-105" />
          <span class="absolute bottom-3 left-3 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-forest-800 opacity-0 transition group-hover:opacity-100">{img.label}</span>
        </button>
      ))}
    </div>
  </section>
  <Lightbox />
</Base>
