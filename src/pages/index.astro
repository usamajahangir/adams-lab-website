---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import Avatar from '@/components/Avatar.astro';
import { getMembers, getMemberMap, getProjects, getPublications, fmtDate } from '@/lib/content';
import { SITE, PH, FEATURES } from '@/site';

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const pubs = await getPublications();
const memberMap = await getMemberMap();
const current = (await getMembers()).filter((m) => m.data.status === 'current');
const withPhotos = current.filter((m) => m.data.photo);
const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const now = new Date();

const stats = [
  { value: research.length, suffix: '', label: 'Research platforms' },
  { value: current.length, suffix: '', label: 'Researchers' },
  { value: projects.length, suffix: '', label: 'Projects', hidden: !FEATURES.projects },
  { value: pubs.length, suffix: '+', label: 'Publications' },
].filter((s) => !s.hidden);
const keywords = PH.keywords;
// Bento layout for the four research platforms
const bento = ['lg:col-span-2 lg:row-span-2 min-h-[22rem] lg:min-h-0', 'min-h-[18rem]', 'min-h-[18rem]', 'lg:col-span-2 min-h-[18rem]'];
---

<Base>
  <!-- HERO ------------------------------------------------------------ -->
  <section class="grain relative isolate overflow-hidden bg-forest-950 text-white">
    <div class="bg-grid mask-fade absolute inset-0 -z-10"></div>
    <div class="pointer-events-none absolute -top-48 -left-40 -z-10 size-[44rem] rounded-full bg-forest-600/40 blur-[140px]"></div>
    <div class="pointer-events-none absolute top-1/3 -right-40 -z-10 size-[32rem] rounded-full bg-amber-500/15 blur-[140px]"></div>

    <div class="container-x grid items-center gap-14 pt-36 pb-20 sm:pt-44 lg:grid-cols-12 lg:gap-10 lg:pb-28">
      <div class="lg:col-span-6">
        <p class="glass inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-medium text-forest-100 animate-fade-up">
          <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-amber-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-amber-400"></span></span>
          {SITE.university} · Edmonton
        </p>
        <h1 class="mt-7 text-5xl leading-[1.04] !text-white sm:text-6xl xl:text-[4.25rem] 2xl:text-7xl animate-fade-up [animation-delay:80ms]">
          Additive Design and <em class="text-gradient pr-2 font-medium">Manufacturing</em> Systems Lab
        </h1>
        <p class="mt-7 max-w-xl font-serif text-2xl text-forest-100/90 italic animate-fade-up [animation-delay:160ms] sm:text-3xl">
          Innovate. Collaborate. Advance.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-3 animate-fade-up [animation-delay:240ms]">
          <a href="/research" class="group inline-flex items-center gap-2 rounded-full bg-amber-500 py-3 pr-3 pl-6 text-sm font-semibold text-forest-950 transition hover:bg-amber-400">
            Explore our research
            <span class="flex size-7 items-center justify-center rounded-full bg-forest-950 text-amber-400 transition group-hover:translate-x-0.5">→</span>
          </a>
          <a href="/team" class="glass inline-flex items-center gap-3 rounded-full py-2 pr-5 pl-2 text-sm font-semibold transition hover:bg-white/20">
            <span class="flex -space-x-2">
              {withPhotos.slice(0, 3).map((m) => <Avatar name={m.data.name} photo={m.data.photo} size="sm" class="size-8 rounded-full ring-2 ring-forest-900" />)}
            </span>
            Meet the team
          </a>
        </div>
      </div>

      <!-- Visual -->
      <div class="relative lg:col-span-6 animate-fade-up [animation-delay:200ms]">
        <div class="relative overflow-hidden rounded-[2rem] ring-1 ring-white/15 shadow-[0_40px_120px_-30px_rgba(0,0,0,0.6)]">
          <img src="/images/site/hero.jpg" alt="FANUC and YASKAWA robots in the ADaMS hybrid manufacturing cell" class="aspect-[4/3] w-full object-cover animate-slow-zoom" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-forest-950/70 via-transparent to-transparent"></div>
          <div class="absolute right-5 bottom-5 left-5 flex items-end justify-end gap-3">
            <div class="glass rounded-2xl px-4 py-3">
              <p class="text-[11px] font-semibold tracking-wider text-amber-300 uppercase">[Placeholder] Label</p>
              <p class="mt-0.5 text-sm font-medium text-white">Image caption goes here</p>
            </div>
          </div>
        </div>
        <!-- floating cards -->
        <div class="glass-light absolute -top-6 -right-3 hidden rounded-2xl px-5 py-4 text-forest-900 shadow-xl animate-float sm:block lg:-right-6">
          <p class="font-serif text-3xl font-semibold"><span data-count={pubs.length}>{pubs.length}</span>+</p>
          <p class="text-xs font-medium text-muted">peer-reviewed publications</p>
        </div>
        <div class="glass-light absolute -bottom-8 -left-3 hidden items-center gap-3 rounded-2xl px-4 py-3 text-forest-900 shadow-xl animate-float [animation-delay:-3s] sm:flex lg:-left-8">
          <span class="flex size-10 items-center justify-center rounded-xl bg-forest-700 text-white">
            <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" /></svg>
          </span>
          <div>
            <p class="text-sm font-semibold">{research.length} research platforms</p>
            <p class="text-xs text-muted">[Placeholder] Sub-caption</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Stats -->
    <div class="container-x pb-14">
      <div class:list={['glass grid grid-cols-2 divide-white/10 overflow-hidden rounded-3xl lg:divide-x', stats.length === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']}>
        {stats.map((s) => (
          <div class="px-6 py-6 lg:py-7">
            <p class="font-serif text-4xl font-semibold text-white sm:text-5xl"><span data-count={s.value}>{s.value}</span><span class="text-amber-400">{s.suffix}</span></p>
            <p class="mt-1 text-sm text-forest-100/60">{s.label}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Marquee -->
    <div class="relative flex overflow-hidden border-t border-white/10 bg-forest-950/60 py-5 [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]" aria-hidden="true">
      <div class="flex shrink-0 animate-marquee items-center gap-10 pr-10 whitespace-nowrap">
        {[...keywords, ...keywords].map((k) => (
          <span class="flex items-center gap-10 font-serif text-xl text-forest-100/70 italic">{k}<span class="text-sm text-amber-500 not-italic">✦</span></span>
        ))}
      </div>
    </div>
  </section>

  <!-- RESEARCH BENTO ------------------------------------------------- -->
  <section class="container-x py-24 sm:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-5" data-reveal>
        <p class="eyebrow">Research</p>
        <h2 class="mt-5 text-4xl leading-[1.05] sm:text-6xl">Research <em class="text-forest-600">Focus</em></h2>
      </div>
      <p class="text-lg leading-relaxed text-muted lg:col-span-7" data-reveal>{SITE.focus}</p>
    </div>

    <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:auto-rows-[18rem] lg:grid-cols-4">
      {research.map((r, i) => (
        <a href={`/research/${r.id}`} class:list={['spotlight group relative isolate flex flex-col justify-between overflow-hidden rounded-[2rem] bg-forest-900 p-7 text-white', bento[i]]} data-reveal style={`transition-delay:${i * 80}ms`}>
          <img src={r.data.image} alt="" loading="lazy" class="absolute inset-0 -z-20 size-full object-cover transition duration-[1.2s] group-hover:scale-110" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-forest-950 via-forest-950/40 to-forest-950/10"></div>
          <div class="flex items-start justify-between">
            <span class="glass rounded-full px-3 py-1 font-mono text-xs text-white/90">0{i + 1}</span>
            <span class="glass flex size-10 items-center justify-center rounded-full transition duration-300 group-hover:rotate-[-45deg] group-hover:bg-amber-500 group-hover:text-forest-950">→</span>
          </div>
          <div>
            <h3 class:list={['leading-tight !text-white', i === 0 ? 'text-3xl sm:text-4xl' : 'text-xl sm:text-2xl']}>{r.data.cardTitle ?? r.data.title}</h3>
            <p class:list={['mt-3 max-w-md text-sm leading-relaxed text-forest-100/80', i === 0 ? 'block' : 'line-clamp-2']}>{r.data.summary}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-amber-300">Read More</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- NEWS & EVENTS -------------------------------------------------- -->
  <section id="events" class="relative scroll-mt-20 overflow-hidden bg-forest-50/60 py-24 sm:py-32">
    <div class="bg-grid-dark mask-fade absolute inset-0"></div>
    <div class="container-x relative">
      <div data-reveal>
        <p class="eyebrow">News &amp; events</p>
        <h2 class="mt-5 text-4xl sm:text-6xl">Events</h2>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2">
        {news.slice(0, 4).map((n) => {
          const upcoming = (n.data.endDate ?? n.data.date) >= now;
          return (
            <article class="spotlight group card card-hover grid sm:grid-cols-[1fr_1.1fr]" data-reveal>
              {n.data.image && (
                <div class="relative aspect-[16/10] overflow-hidden sm:aspect-auto">
                  <img src={n.data.image} alt="" loading="lazy" class="size-full object-cover transition duration-700 group-hover:scale-105" />
                  <div class="glass-light absolute top-4 left-4 rounded-2xl px-3 py-2 text-center text-forest-900">
                    <p class="text-[10px] font-bold tracking-widest uppercase">{fmtDate(n.data.date, { month: 'short' })}</p>
                    <p class="font-serif text-2xl leading-none font-semibold">{fmtDate(n.data.date, { day: 'numeric' })}</p>
                  </div>
                </div>
              )}
              <div class="flex flex-col p-6 sm:p-7">
                <div class="flex items-center gap-2">
                  <span class="chip capitalize">{n.data.kind}</span>
                  {upcoming && <span class="inline-flex items-center gap-1.5 rounded-full bg-amber-500/15 px-2.5 py-0.5 text-xs font-semibold text-amber-600"><span class="size-1.5 rounded-full bg-amber-500"></span>Upcoming</span>}
                </div>
                <h3 class="mt-4 text-2xl sm:text-3xl">{n.data.title}</h3>
                <p class="mt-2 text-sm font-medium text-forest-700">{n.data.dateLabel ?? fmtDate(n.data.date)}{n.data.location && ` · ${n.data.location}`}</p>
                {n.data.summary && <p class="mt-3 text-sm leading-relaxed text-ink/75">{n.data.summary}</p>}
                {n.data.link && (
                  <a href={n.data.link} target="_blank" rel="noopener" class="mt-auto inline-flex items-center gap-1.5 pt-6 text-sm font-semibold text-forest-700 after:absolute after:inset-0 hover:text-forest-900">
                    Learn More <span class="transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS (hidden while features.projects = false) ---- -->
  {FEATURES.projects && featured.length > 0 && <section class="container-x py-24 sm:py-32">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Featured projects</p>
        <h2 class="mt-5 text-4xl sm:text-6xl">Projects</h2>
        <p class="mt-4 max-w-xl text-muted">{PH.short}</p>
      </div>
      <a href="/projects" class="btn-outline">All projects →</a>
    </div>
    <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>}

  <!-- PUBLICATIONS + TEAM ------------------------------------------- -->
  <section class:list={['container-x grid gap-16 lg:grid-cols-12', !FEATURES.projects && 'pt-24 sm:pt-32']}>
    <div class="lg:col-span-7">
      <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <p class="eyebrow">Latest publications</p>
          <h2 class="mt-5 text-4xl sm:text-5xl">Publications</h2>
        </div>
        <a href="/publications" class="btn-outline">All publications →</a>
      </div>
      <ul class="mt-10 space-y-4">
        {pubs.slice(0, 4).map((p) => <PublicationItem pub={p} memberMap={memberMap} />)}
      </ul>
    </div>

    <aside class="lg:col-span-5">
      <div class="grain sticky top-28 overflow-hidden rounded-[2rem] bg-forest-900 p-8 text-white" data-reveal>
        <div class="bg-grid mask-fade absolute inset-0"></div>
        <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-amber-500/25 blur-3xl"></div>
        <div class="relative">
          <p class="eyebrow !text-amber-300">The people</p>
          <h2 class="mt-5 text-3xl !text-white sm:text-4xl">Team</h2>
          <p class="mt-3 text-forest-100/70">{PH.short}</p>
          <div class="mt-8 grid grid-cols-5 gap-2">
            {withPhotos.slice(0, 10).map((m, i) => (
              <a href={`/team/${m.id}`} title={m.data.name} class:list={['block overflow-hidden rounded-2xl ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:ring-amber-400', i % 2 && 'translate-y-3']}>
                <Avatar name={m.data.name} photo={m.data.photo} size="fill" class="aspect-[3/4]" />
              </a>
            ))}
          </div>
          <a href="/team" class="mt-12 inline-flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-semibold text-forest-950 transition hover:bg-amber-400">Meet the team →</a>
        </div>
      </div>
    </aside>
  </section>

  <!-- GALLERY (from the original home page) ------------------------- -->
  <section class="container-x pt-28">
    <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
      <div>
        <p class="eyebrow">Inside the lab</p>
        <h2 class="mt-5 text-4xl sm:text-6xl">Gallery</h2>
      </div>
      <a href="/gallery" class="btn-outline">View gallery →</a>
    </div>
    <div class="mt-12 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:grid-rows-2">
      {['/images/gallery/g01.jpg', '/images/gallery/g02.jpg', '/images/research/metal-hybrid-3.jpg', '/images/research/composite-hybrid-4.jpg', '/images/research/metal-am-6.jpg'].map((src, i) => (
        <a href="/gallery" class:list={['group block overflow-hidden rounded-[1.5rem]', i === 0 && 'col-span-2 row-span-2']} data-reveal>
          <img src={src} alt="" loading="lazy" class:list={['size-full object-cover transition duration-700 group-hover:scale-105', i === 0 ? 'aspect-square lg:aspect-auto' : 'aspect-[4/3]']} />
        </a>
      ))}
    </div>
  </section>

  <!-- CTA ------------------------------------------------------------ -->
  <section class="container-x pt-28">
    <div class="grain relative isolate overflow-hidden rounded-[2.5rem] bg-forest-950 px-6 py-20 text-center sm:px-16" data-reveal>
      <img src="/images/site/focus.jpg" alt="" class="absolute inset-0 -z-20 size-full object-cover opacity-20" loading="lazy" />
      <div class="bg-grid mask-fade absolute inset-0 -z-10"></div>
      <div class="pointer-events-none absolute -bottom-40 left-1/2 -z-10 size-[36rem] -translate-x-1/2 rounded-full bg-forest-500/40 blur-[120px]"></div>
      <p class="eyebrow justify-center !text-amber-300">{SITE.footerName}</p>
      <h2 class="mx-auto mt-5 max-w-3xl text-4xl leading-tight !text-white sm:text-6xl">Contact <em class="text-gradient">Us</em></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-forest-100/75">{SITE.contactLead}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-semibold text-forest-950 transition hover:bg-amber-400">Contact Us →</a>
        <a href={`mailto:${SITE.email}`} class="glass inline-flex items-center rounded-full px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/20">{SITE.email}</a>
      </div>
    </div>
  </section>
</Base>
