---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import PublicationItem from '@/components/PublicationItem.astro';
import { getPublications, getMemberMap, getMembers } from '@/lib/content';

const pubs = await getPublications();
const memberMap = await getMemberMap();
const years = [...new Set(pubs.map((p) => p.data.year))].sort((a, b) => b - a);
const types = [...new Set(pubs.map((p) => p.data.type))];
const taggedIds = new Set(pubs.flatMap((p) => p.data.members.map((m) => m.id)));
const members = (await getMembers()).filter((m) => taggedIds.has(m.id)).sort((a, b) => a.data.name.localeCompare(b.data.name));
const typeLabel: Record<string, string> = { journal: 'Journal', conference: 'Conference', preprint: 'Preprint', 'book-chapter': 'Book chapter', thesis: 'Thesis' };
---

<Base title="Publications" description="Peer-reviewed publications from the ADaMS Lab.">
  <PageHero eyebrow="Publications" title="Publications" lead={`${pubs.length} publications in journals, conferences and preprints.`} image="/images/research/metal-am-2.jpg" />

  <section class="container-x py-12 sm:py-16">
    <div class="sticky top-[4.75rem] z-30 -mx-4 border-b border-line bg-paper/90 px-4 py-4 backdrop-blur-lg sm:top-24 sm:mx-0 sm:rounded-3xl sm:border sm:bg-white/80 sm:px-5 lg:top-[6.5rem]">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto_auto]">
        <label class="relative">
          <span class="sr-only">Search publications</span>
          <svg class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path stroke-linecap="round" d="M20 20l-3.5-3.5" /></svg>
          <input id="pub-search" type="search" placeholder="Search title, author, venue…" class="w-full rounded-full border border-line bg-white py-2.5 pr-4 pl-10 text-sm outline-none focus:border-forest-500 focus:ring-2 focus:ring-forest-100" />
        </label>
        <select id="pub-year" class="pub-select" aria-label="Filter by year">
          <option value="">All years</option>
          {years.map((y) => <option value={y}>{y}</option>)}
        </select>
        <select id="pub-type" class="pub-select" aria-label="Filter by type">
          <option value="">All types</option>
          {types.map((t) => <option value={t}>{typeLabel[t]}</option>)}
        </select>
        <select id="pub-member" class="pub-select" aria-label="Filter by lab member">
          <option value="">All members</option>
          {members.map((m) => <option value={m.id}>{m.data.name}</option>)}
        </select>
      </div>
      <p class="mt-3 text-xs text-muted" aria-live="polite"><span id="pub-count">{pubs.length}</span> results</p>
    </div>

    <div class="mt-10 space-y-14" id="pub-list">
      {years.map((y) => (
        <section data-year-group={y}>
          <div class="flex items-center gap-4">
            <h2 class="font-serif text-3xl text-forest-700">{y}</h2>
            <span class="h-px flex-1 bg-line"></span>
          </div>
          <ul class="mt-6 space-y-4">
            {pubs.filter((p) => p.data.year === y).map((p) => <PublicationItem pub={p} memberMap={memberMap} />)}
          </ul>
        </section>
      ))}
      <p id="pub-empty" hidden class="rounded-2xl border border-dashed border-line p-10 text-center text-muted">No publications match your filters.</p>
    </div>
  </section>
</Base>

<style>
  @reference '../styles/global.css';
  .pub-select { @apply rounded-full border border-line bg-white px-4 py-2.5 text-sm text-ink outline-none focus:border-forest-500 focus:ring-2 focus:ring-forest-100; }
</style>

<script>
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const q = $<HTMLInputElement>('pub-search');
  const year = $<HTMLSelectElement>('pub-year');
  const type = $<HTMLSelectElement>('pub-type');
  const member = $<HTMLSelectElement>('pub-member');
  const items = [...document.querySelectorAll<HTMLElement>('[data-pub]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-year-group]')];

  // Allow deep links like /publications?member=sajid-ullah-butt
  const params = new URLSearchParams(location.search);
  if (params.get('member')) member.value = params.get('member')!;
  if (params.get('year')) year.value = params.get('year')!;

  function apply() {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    let n = 0;
    for (const el of items) {
      const ok =
        terms.every((t) => el.dataset.search!.includes(t)) &&
        (!year.value || el.dataset.year === year.value) &&
        (!type.value || el.dataset.type === type.value) &&
        (!member.value || el.dataset.members!.split(' ').includes(member.value));
      el.hidden = !ok;
      if (ok) n++;
    }
    groups.forEach((g) => { g.hidden = !g.querySelector('[data-pub]:not([hidden])'); });
    $('pub-count').textContent = String(n);
    $('pub-empty').hidden = n > 0;
  }
  [q, year, type, member].forEach((el) => el.addEventListener('input', apply));
  apply();
</script>
