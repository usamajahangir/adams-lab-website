---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Lightbox from '@/components/Lightbox.astro';
import { PH, FEATURES } from '@/site';

export async function getStaticPaths() {
  const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
  return research.map((entry, i) => ({ params: { id: entry.id }, props: { entry, next: research[(i + 1) % research.length] } }));
}
const { entry, next } = Astro.props;
const projects = FEATURES.projects ? (await getCollection('projects')).filter((p) => p.data.area.id === entry.id) : [];
---

<Base title={entry.data.short} description={entry.data.summary} image={entry.data.image}>
  <PageHero eyebrow="Research platform" title={entry.data.title} lead={entry.data.summary} image={entry.data.image} />

  <section class="container-x grid gap-12 py-16 sm:py-20 lg:grid-cols-12">
    <div class="prose-lab lg:col-span-7" data-reveal>{entry.data.description.map((p) => <p>{p}</p>)}</div>
    <aside class="lg:col-span-5" data-reveal>
      <div class="rounded-3xl border border-line bg-white p-7">
        <h2 class="font-sans text-xs font-semibold tracking-[0.18em] text-forest-600 uppercase">Capabilities</h2>
        <ul class="mt-5 space-y-3">
          {(entry.data.capabilities.length ? entry.data.capabilities : PH.capabilities).map((c) => (
            <li class="flex gap-3 text-sm text-ink/85">
              <svg class="mt-0.5 size-4 shrink-0 text-amber-500" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
              {c}
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </section>

  {entry.data.gallery.length > 0 && (
    <section class="container-x pb-8">
      <h2 class="text-2xl sm:text-3xl" data-reveal>Gallery</h2>
      <div class="mt-8 columns-1 gap-4 sm:columns-2 lg:columns-3 [&>*]:mb-4">
        {entry.data.gallery.map((src) => (
          <button type="button" data-lightbox={src} class="group block w-full overflow-hidden rounded-2xl" data-reveal aria-label="Open image">
            <img src={src} alt="" loading="lazy" class="w-full transition duration-500 group-hover:scale-105" />
          </button>
        ))}
      </div>
    </section>
  )}

  {projects.length > 0 && (
    <section class="container-x py-16">
      <p class="eyebrow">Projects</p>
      <h2 class="mt-4 text-2xl sm:text-3xl">Projects on this platform</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>
  )}

  <section class="container-x pt-8">
    <a href={`/research/${next.id}`} class="group flex items-center justify-between gap-6 rounded-3xl border border-line bg-white p-7 transition hover:border-forest-300 hover:bg-forest-50">
      <div>
        <p class="text-xs font-semibold tracking-wide text-muted uppercase">Next platform</p>
        <p class="mt-1 font-serif text-2xl text-forest-900">{next.data.short}</p>
      </div>
      <span class="text-2xl text-forest-700 transition group-hover:translate-x-1">→</span>
    </a>
  </section>
  <Lightbox />
</Base>
